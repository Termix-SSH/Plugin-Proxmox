{
  "id": "proxmox",
  "name": "Proxmox",
  "version": "1.4.0",
  "description": "Import Proxmox VE guests as hosts, keep them in sync and watch node stats.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Proxmox",
  "docs": "https://docs.termix.site/plugins/proxmox",
  "video": "https://www.youtube.com/watch?v=6nToeUHcdSw",
  "category": "Infrastructure",
  "icon": "Server",
  "features": [
    "Find and import VMs and LXC containers from a node",
    "Keep imported hosts in sync on a schedule",
    "Set up Windows guests for RDP and turn on Docker for guests by name",
    "Node, guest, storage and cluster stats in their own tab",
    "A dashboard card with CPU, memory, disk and guests for each node",
    "Open a VM's screen with noVNC, a container shell or a serial console right in Termix",
    "Create VMs and containers, and clone guests"
  ],
  "engine": {
    "termix": ">=26.11.2-0",
    "api": "^2.7.0"
  },
  "capabilities": [
    "hosts:read",
    "hosts:write",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface",
    "kv:own",
    "notify:send",
    "users:impersonate",
    "operations:provide"
  ],
  "sandbox": {
    "schedules": [
      {
        "id": "host-alerts",
        "every": 120000
      }
    ]
  },
  "contributes": {
    "tabs": [
      {
        "id": "proxmox-stats",
        "titleKey": "nav.proxmoxStats",
        "icon": "HardDrive",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "settings": {
      "host": {
        "fields": [
          {
            "key": "enableProxmox",
            "type": "custom",
            "component": "proxmoxHostSettings",
            "defaultable": false
          },
          {
            "key": "proxmoxConfig",
            "type": "custom",
            "component": "proxmoxHostSettings",
            "defaultable": false
          },
          {
            "key": "enableProxmoxStats",
            "type": "custom",
            "component": "proxmoxHostSettings",
            "defaultable": false
          },
          {
            "key": "proxmoxStatsConfig",
            "type": "custom",
            "component": "proxmoxHostSettings",
            "defaultable": false
          },
          {
            "key": "alertGuests",
            "type": "boolean",
            "labelKey": "settings.host.alertGuests.label",
            "descriptionKey": "settings.host.alertGuests.description",
            "default": false
          }
        ]
      }
    },
    "uses": ["homepage.widgets"],
    "dashboardCards": [
      {
        "id": "proxmox-nodes",
        "titleKey": "card.title",
        "icon": "HardDrive"
      }
    ],
    "permissions": [
      {
        "name": "guests",
        "titleKey": "permissions.guests.title",
        "descriptionKey": "permissions.guests.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "proxmox.list-guests",
          "titleKey": "operations.list.title",
          "scope": "host",
          "risk": "read",
          "permission": "guests",
          "hostAccess": "connect",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          },
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.start-guest",
          "titleKey": "operations.start.title",
          "icon": "Play",
          "scope": "resource",
          "risk": "change",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "idempotent": true,
          "resource": "proxmox.guest",
          "surfaces": {
            "assistant": true,
            "mcp": true
          },
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.shutdown-guest",
          "titleKey": "operations.shutdown.title",
          "icon": "Power",
          "scope": "resource",
          "risk": "destructive",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "resource": "proxmox.guest",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.reboot-guest",
          "titleKey": "operations.reboot.title",
          "icon": "RotateCw",
          "scope": "resource",
          "risk": "destructive",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "resource": "proxmox.guest",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.stop-guest",
          "titleKey": "operations.stop.title",
          "icon": "Square",
          "scope": "resource",
          "risk": "destructive",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "resource": "proxmox.guest",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.list-snapshots",
          "titleKey": "operations.snapshots.list",
          "scope": "host",
          "risk": "read",
          "permission": "guests",
          "hostAccess": "connect",
          "inputs": [
            {
              "key": "vmid",
              "type": "string",
              "labelKey": "operations.snapshots.vmid",
              "pattern": "[0-9]{1,9}"
            }
          ],
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          },
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.create-snapshot",
          "titleKey": "operations.snapshots.create",
          "icon": "Camera",
          "scope": "resource",
          "resource": "proxmox.guest",
          "risk": "change",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "inputs": [
            {
              "key": "name",
              "type": "string",
              "labelKey": "operations.snapshots.name",
              "pattern": "[A-Za-z][A-Za-z0-9_-]{1,39}"
            },
            {
              "key": "description",
              "type": "string",
              "labelKey": "operations.snapshots.description"
            },
            {
              "key": "vmstate",
              "type": "boolean",
              "labelKey": "operations.snapshots.vmstate"
            }
          ],
          "surfaces": {
            "assistant": true,
            "mcp": true
          },
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.rollback-snapshot",
          "titleKey": "operations.snapshots.rollback",
          "icon": "History",
          "scope": "resource",
          "resource": "proxmox.snapshot",
          "risk": "destructive",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "exclusive": true,
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.delete-snapshot",
          "titleKey": "operations.snapshots.delete",
          "icon": "Trash2",
          "scope": "resource",
          "resource": "proxmox.snapshot",
          "risk": "destructive",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.create-vm",
          "titleKey": "operations.guestForm.createVm",
          "icon": "Plus",
          "scope": "host",
          "risk": "change",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          },
          "inputs": [
            {
              "key": "name",
              "type": "string",
              "labelKey": "operations.guestForm.name",
              "required": true
            },
            {
              "key": "node",
              "type": "string",
              "labelKey": "operations.guestForm.node",
              "required": true
            },
            {
              "key": "vmid",
              "type": "number",
              "labelKey": "operations.guestForm.vmid",
              "min": 100,
              "max": 999999999
            },
            {
              "key": "cores",
              "type": "number",
              "labelKey": "operations.guestForm.cores",
              "min": 1,
              "max": 512
            },
            {
              "key": "memoryMiB",
              "type": "number",
              "labelKey": "operations.guestForm.memory",
              "min": 16,
              "max": 4194304
            },
            {
              "key": "diskGiB",
              "type": "number",
              "labelKey": "operations.guestForm.disk",
              "min": 1,
              "max": 65536
            },
            {
              "key": "storage",
              "type": "string",
              "labelKey": "operations.guestForm.storage",
              "required": true
            },
            {
              "key": "bridge",
              "type": "string",
              "labelKey": "operations.guestForm.bridge",
              "default": "vmbr0"
            },
            {
              "key": "start",
              "type": "boolean",
              "labelKey": "operations.guestForm.start",
              "default": false
            },
            {
              "key": "iso",
              "type": "string",
              "labelKey": "operations.guestForm.iso"
            }
          ],
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        },
        {
          "id": "proxmox.create-ct",
          "titleKey": "operations.guestForm.createCt",
          "icon": "Plus",
          "scope": "host",
          "risk": "change",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          },
          "inputs": [
            {
              "key": "hostname",
              "type": "string",
              "labelKey": "operations.guestForm.hostname",
              "required": true
            },
            {
              "key": "template",
              "type": "string",
              "labelKey": "operations.guestForm.template",
              "required": true
            },
            {
              "key": "node",
              "type": "string",
              "labelKey": "operations.guestForm.node",
              "required": true
            },
            {
              "key": "vmid",
              "type": "number",
              "labelKey": "operations.guestForm.vmid",
              "min": 100,
              "max": 999999999
            },
            {
              "key": "cores",
              "type": "number",
              "labelKey": "operations.guestForm.cores",
              "min": 1,
              "max": 512
            },
            {
              "key": "memoryMiB",
              "type": "number",
              "labelKey": "operations.guestForm.memory",
              "min": 16,
              "max": 4194304
            },
            {
              "key": "diskGiB",
              "type": "number",
              "labelKey": "operations.guestForm.disk",
              "min": 1,
              "max": 65536
            },
            {
              "key": "storage",
              "type": "string",
              "labelKey": "operations.guestForm.storage",
              "required": true
            },
            {
              "key": "bridge",
              "type": "string",
              "labelKey": "operations.guestForm.bridge",
              "default": "vmbr0"
            },
            {
              "key": "start",
              "type": "boolean",
              "labelKey": "operations.guestForm.start",
              "default": false
            },
            {
              "key": "unprivileged",
              "type": "boolean",
              "labelKey": "operations.guestForm.unprivileged",
              "default": true
            },
            {
              "key": "sshKey",
              "type": "textarea",
              "labelKey": "operations.guestForm.sshKey"
            }
          ],
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        },
        {
          "id": "proxmox.clone-guest",
          "titleKey": "operations.guestForm.clone",
          "icon": "Copy",
          "scope": "resource",
          "resource": "proxmox.guest",
          "risk": "change",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          },
          "inputs": [
            {
              "key": "name",
              "type": "string",
              "labelKey": "operations.guestForm.name",
              "required": true
            },
            {
              "key": "newid",
              "type": "number",
              "labelKey": "operations.guestForm.vmid",
              "min": 100,
              "max": 999999999
            },
            {
              "key": "full",
              "type": "boolean",
              "labelKey": "operations.guestForm.full",
              "default": false
            },
            {
              "key": "target",
              "type": "string",
              "labelKey": "operations.guestForm.target"
            },
            {
              "key": "storage",
              "type": "string",
              "labelKey": "operations.guestForm.storage"
            }
          ],
          "surfaces": {
            "assistant": false,
            "mcp": false
          }
        }
      ],
      "resources": [
        {
          "id": "proxmox.guest",
          "titleKey": "operations.guests.title",
          "icon": "Server",
          "list": "proxmox.list-guests",
          "key": "id",
          "name": "name",
          "tab": "proxmox-stats",
          "columns": [
            {
              "key": "type",
              "titleKey": "operations.guests.type"
            },
            {
              "key": "node",
              "titleKey": "operations.guests.node"
            },
            {
              "key": "status",
              "titleKey": "operations.guests.status"
            }
          ]
        },
        {
          "id": "proxmox.snapshot",
          "titleKey": "operations.snapshots.title",
          "icon": "History",
          "list": "proxmox.list-snapshots",
          "key": "key",
          "name": "name",
          "tab": "proxmox-stats",
          "columns": [
            {
              "key": "guest",
              "titleKey": "operations.snapshots.guest"
            },
            {
              "key": "createdAt",
              "titleKey": "operations.snapshots.created"
            }
          ],
          "filters": ["guest"]
        }
      ],
      "signals": [
        {
          "id": "proxmox.guests-running",
          "titleKey": "operations.guests.running",
          "read": "proxmox.list-guests",
          "scope": "host",
          "kind": "count",
          "refreshSec": 300
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
