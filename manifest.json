{
  "id": "proxmox",
  "name": "Proxmox",
  "version": "1.3.0",
  "description": "Import Proxmox VE guests as hosts, keep them in sync and watch node stats.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Proxmox",
  "docs": "https://docs.termix.site/plugins/proxmox",
  "video": "https://www.youtube.com/watch?v=FCDouJdgYRk",
  "category": "Infrastructure",
  "icon": "Server",
  "features": [
    "Find and import VMs and LXC containers from a node",
    "Keep imported hosts in sync on a schedule",
    "Set up Windows guests for RDP and turn on Docker for guests by name",
    "Node, guest, storage and cluster stats in their own tab",
    "A dashboard card with CPU, memory, disk and guests for each node"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "hosts:write",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface",
    "kv:own",
    "notify:send",
    "users:impersonate",
    "operations:provide"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "proxmox-stats",
        "titleKey": "nav.proxmoxStats",
        "icon": "HardDrive",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "settings": {
      "host": {
        "fields": [
          {
            "key": "enableProxmox",
            "type": "custom",
            "component": "proxmoxHostSettings",
            "defaultable": false
          },
          {
            "key": "proxmoxConfig",
            "type": "custom",
            "component": "proxmoxHostSettings",
            "defaultable": false
          },
          {
            "key": "enableProxmoxStats",
            "type": "custom",
            "component": "proxmoxHostSettings",
            "defaultable": false
          },
          {
            "key": "proxmoxStatsConfig",
            "type": "custom",
            "component": "proxmoxHostSettings",
            "defaultable": false
          },
          {
            "key": "alertGuests",
            "type": "boolean",
            "labelKey": "settings.host.alertGuests.label",
            "descriptionKey": "settings.host.alertGuests.description",
            "default": false
          }
        ]
      }
    },
    "uses": ["homepage.widgets"],
    "dashboardCards": [
      {
        "id": "proxmox-nodes",
        "titleKey": "card.title",
        "icon": "HardDrive"
      }
    ],
    "permissions": [
      {
        "name": "guests",
        "titleKey": "permissions.guests.title",
        "descriptionKey": "permissions.guests.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "proxmox.list-guests",
          "titleKey": "operations.list.title",
          "scope": "host",
          "risk": "read",
          "permission": "guests",
          "hostAccess": "connect",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          },
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.start-guest",
          "titleKey": "operations.start.title",
          "icon": "Play",
          "scope": "resource",
          "risk": "change",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "idempotent": true,
          "resource": "proxmox.guest",
          "surfaces": {
            "assistant": true,
            "mcp": true
          },
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.shutdown-guest",
          "titleKey": "operations.shutdown.title",
          "icon": "Power",
          "scope": "resource",
          "risk": "destructive",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "resource": "proxmox.guest",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.reboot-guest",
          "titleKey": "operations.reboot.title",
          "icon": "RotateCw",
          "scope": "resource",
          "risk": "destructive",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "resource": "proxmox.guest",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        },
        {
          "id": "proxmox.stop-guest",
          "titleKey": "operations.stop.title",
          "icon": "Square",
          "scope": "resource",
          "risk": "destructive",
          "permission": "guests",
          "hostAccess": "edit",
          "dryRun": "describe",
          "resource": "proxmox.guest",
          "when": {
            "settings": {
              "enableProxmox": true
            }
          }
        }
      ],
      "resources": [
        {
          "id": "proxmox.guest",
          "titleKey": "operations.guests.title",
          "icon": "Server",
          "list": "proxmox.list-guests",
          "key": "id",
          "name": "name",
          "tab": "proxmox-stats",
          "columns": [
            {
              "key": "type",
              "titleKey": "operations.guests.type"
            },
            {
              "key": "node",
              "titleKey": "operations.guests.node"
            },
            {
              "key": "status",
              "titleKey": "operations.guests.status"
            }
          ]
        }
      ],
      "signals": [
        {
          "id": "proxmox.guests-running",
          "titleKey": "operations.guests.running",
          "read": "proxmox.list-guests",
          "scope": "host",
          "kind": "count",
          "refreshSec": 300
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
